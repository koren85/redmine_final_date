<h3><%= l(:label_settings) %></h3>
<p>
  <label for="custom_field_id"><%= l(:label_custom_field) %>:</label>
<!-- <%#= select_tag 'settings[custom_field_id]', options_from_collection_for_select(CustomField.all, 'id', 'name', @settings['custom_field_id'].to_i) %>-->
  <%= select_tag 'settings[custom_field_id]', options_from_collection_for_select(CustomField.where(field_format: 'date'), 'id', 'name', @settings['custom_field_id'].to_i) %>

</p>

<p>
<label for="check_subtask"><%= l(:label_check_subtask) %>:</label>
<%= check_box_tag 'settings[check_subtask]', '1', @settings['check_subtask'] %>

</p>

<%# ================================================================ %>
<%# Automated date update section                                    %>
<%# ================================================================ %>

<h3><%= l(:label_auto_date_update_settings) %></h3>

<%# --- filter_id -------------------------------------------------- %>
<p>
  <label for="settings_filter_id"><%= l(:label_filter_id) %>:</label><br/>
  <%
    query_options = IssueQuery.order(:name).map { |q| [q.name, q.id] }
  %>
  <%= select_tag 'settings[filter_id]',
        options_for_select(query_options, @settings['filter_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_filter_id' %>
  <a id="rfd_edit_filter_link"
     href="#"
     target="_blank"
     style="display:none; margin-left:6px; vertical-align:middle;"
     title="Редактировать фильтр">&#9998;</a>
</p>

<%# --- date_mode -------------------------------------------------- %>
<p>
  <label for="settings_date_mode"><%= l(:label_date_mode) %>:</label><br/>
  <%
    date_mode_options = [
      [l(:label_date_mode_add_to_today), 'add_to_today'],
      [l(:label_date_mode_add_to_field), 'add_to_field'],
      [l(:label_date_mode_set_fixed),    'set_fixed']
    ]
  %>
  <%= select_tag 'settings[date_mode]',
        options_for_select(date_mode_options, @settings['date_mode']),
        id: 'settings_date_mode' %>
</p>

<%# --- date_days (visible for add_to_today / add_to_field) -------- %>
<p id="rfd_date_days_row">
  <label for="settings_date_days"><%= l(:label_date_days) %>:</label>
  <%= text_field_tag 'settings[date_days]', @settings['date_days'],
        id: 'settings_date_days', size: 6 %>
  <em class="info"><%= l(:hint_date_days) %></em>
</p>

<%# --- date_fixed (visible only for set_fixed) ------------------- %>
<p id="rfd_date_fixed_row" style="display:none;">
  <label for="settings_date_fixed"><%= l(:label_date_fixed) %>:</label>
  <%= text_field_tag 'settings[date_fixed]', @settings['date_fixed'],
        id: 'settings_date_fixed', size: 12, placeholder: 'YYYY-MM-DD' %>
</p>

<%# --- comment_text ----------------------------------------------- %>
<p>
  <label for="settings_comment_text"><%= l(:label_comment_text) %>:</label><br/>
  <%= text_area_tag 'settings[comment_text]', @settings['comment_text'],
        id: 'settings_comment_text', rows: 3, cols: 60 %>
</p>

<%# --- acting_user_id --------------------------------------------- %>
<p>
  <label for="settings_acting_user_id"><%= l(:label_acting_user_id) %>:</label><br/>
  <%
    user_options = User.active.sorted.map { |u| [u.name, u.id] }
  %>
  <%= select_tag 'settings[acting_user_id]',
        options_for_select(user_options, @settings['acting_user_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_acting_user_id' %>
  <em class="info"><%= l(:hint_acting_user_id) %></em>
</p>

<%# --- responsible_field_id --------------------------------------- %>
<p>
  <label for="settings_responsible_field_id"><%= l(:label_responsible_field_id) %>:</label><br/>
  <%
    user_field_options = CustomField.where(type: 'IssueCustomField', field_format: 'user').order(:name).map { |f| [f.name, f.id] }
  %>
  <%= select_tag 'settings[responsible_field_id]',
        options_for_select(user_field_options, @settings['responsible_field_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_responsible_field_id' %>
  <em class="info"><%= l(:hint_responsible_field_id) %></em>
</p>

<%# --- cron_schedule ---------------------------------------------- %>
<p>
  <label for="settings_cron_schedule"><%= l(:label_cron_schedule) %>:</label><br/>
  <%= text_field_tag 'settings[cron_schedule]', @settings['cron_schedule'],
        id: 'settings_cron_schedule', size: 25, placeholder: '0 16 * * 1-5' %>
</p>

<p>
  <strong><%= l(:label_cron_command) %>:</strong><br/>
  <code style="display:block;background:#f4f4f4;padding:8px;margin-top:4px;font-size:12px;word-break:break-all;">
    <%= h(@settings['cron_schedule'].presence || '0 16 * * 1-5') %>
    &nbsp;cd <%= h(Rails.root.to_s) %> &amp;&amp; RAILS_ENV=<%= h(Rails.env) %> bundle exec rake redmine:final_date:update_dates &gt;&gt; /var/log/redmine_final_date.log 2&gt;&amp;1
  </code>
</p>

<%# ================================================================ %>
<%# Select2 + toggle JS                                              %>
<%# ================================================================ %>

<%= javascript_include_tag 'select2/select2.js', plugin: 'a_common_libs' %>
<%= stylesheet_link_tag 'select2', plugin: 'a_common_libs' %>

<script type="text/javascript">
(function($) {
  $(document).ready(function() {
    // Initialise Select2 on all plugin dropdowns
    $('.rfd-select2').select2({ width: '300px' });

    // Show/hide date_days vs date_fixed based on selected mode
    function rfdToggleDateFields() {
      var mode = $('#settings_date_mode').val();
      if (mode === 'set_fixed') {
        $('#rfd_date_days_row').hide();
        $('#rfd_date_fixed_row').show();
      } else {
        $('#rfd_date_fixed_row').hide();
        $('#rfd_date_days_row').show();
      }
    }

    rfdToggleDateFields();
    $('#settings_date_mode').on('change', rfdToggleDateFields);

    // Update edit-filter link when query selection changes
    function rfdUpdateFilterLink() {
      var id  = $('#settings_filter_id').val();
      var $a  = $('#rfd_edit_filter_link');
      if (id) {
        $a.attr('href', '/queries/' + id + '/edit').show();
      } else {
        $a.hide();
      }
    }

    rfdUpdateFilterLink();
    $('#settings_filter_id').on('change', rfdUpdateFilterLink);
  });
})(jQuery);
</script>
