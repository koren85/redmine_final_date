<%# Redmine hands us @settings — the raw stored hash, which lacks every key added
    since the admin last pressed Save. Read through the plugin's accessor instead
    so the form is pre-filled with the registered defaults. %>
<% settings = RedmineFinalDate::Settings.all %>

<h3><%= l(:label_settings) %></h3>
<p>
  <label for="settings_custom_field_id"><%= l(:label_custom_field) %>:</label>
  <%= select_tag 'settings[custom_field_id]',
        options_from_collection_for_select(CustomField.where(field_format: 'date').order(:name),
                                           'id', 'name', settings['custom_field_id'].to_i),
        include_blank: true,
        id: 'settings_custom_field_id' %>
</p>

<p>
  <label for="settings_check_subtask"><%= l(:label_check_subtask) %>:</label>
  <%# check_box_tag has no companion hidden field, so an unchecked box would post
      nothing at all and the key would silently vanish from the settings hash. %>
  <%= hidden_field_tag 'settings[check_subtask]', '0', id: nil %>
  <%= check_box_tag 'settings[check_subtask]', '1',
        RedmineFinalDate::Settings.truthy?(settings['check_subtask']),
        id: 'settings_check_subtask' %>
</p>

<%# ================================================================ %>
<%# Subtasks mirror the owner's date                                 %>
<%# ================================================================ %>

<h3><%= l(:label_rfd_sync_section) %></h3>
<p>
  <%= hidden_field_tag 'settings[sync_subtasks]', '0', id: nil %>
  <%= check_box_tag 'settings[sync_subtasks]', '1',
        RedmineFinalDate::Settings.truthy?(settings['sync_subtasks']),
        id: 'settings_sync_subtasks' %>
  <label for="settings_sync_subtasks" style="float:none; margin-left:0; width:auto;"><%= l(:label_rfd_sync_subtasks) %></label>
  <br><em class="info"><%= l(:hint_rfd_sync_subtasks) %></em>
</p>

<%# ================================================================ %>
<%# A final date in the past                                         %>
<%# ================================================================ %>

<h3><%= l(:label_rfd_overdue_section) %></h3>
<p>
  <%= hidden_field_tag 'settings[overdue_guard]', '0', id: nil %>
  <%= check_box_tag 'settings[overdue_guard]', '1',
        RedmineFinalDate::Settings.truthy?(settings['overdue_guard']),
        id: 'settings_overdue_guard' %>
  <label for="settings_overdue_guard" style="float:none; margin-left:0; width:auto;"><%= l(:label_rfd_overdue_guard) %></label>
  <br><em class="info"><%= l(:hint_rfd_overdue_guard) %></em>
</p>

<p>
  <label for="settings_overdue_status_ids"><%= l(:label_rfd_overdue_status_ids) %>:</label><br/>
  <%# The hidden blank lets the admin clear the list: an empty multi-select
      posts nothing, and the key would keep its previous value. %>
  <%= hidden_field_tag 'settings[overdue_status_ids][]', '', id: nil %>
  <%= select_tag 'settings[overdue_status_ids][]',
        options_from_collection_for_select(IssueStatus.sorted, 'id', 'name',
                                           RedmineFinalDate::Settings.id_list(settings['overdue_status_ids'])),
        multiple: true, size: 10, class: 'rfd-select2-wide',
        id: 'settings_overdue_status_ids' %>
</p>

<p>
  <label for="settings_staff_group_ids"><%= l(:label_rfd_staff_group_ids) %>:</label><br/>
  <%= hidden_field_tag 'settings[staff_group_ids][]', '', id: nil %>
  <%= select_tag 'settings[staff_group_ids][]',
        options_from_collection_for_select(Group.givable.sorted, 'id', 'name',
                                           RedmineFinalDate::Settings.id_list(settings['staff_group_ids'])),
        multiple: true, size: 10, class: 'rfd-select2-wide',
        id: 'settings_staff_group_ids' %>
  <br><em class="info"><%= l(:hint_rfd_staff_group_ids) %></em>
</p>

<p>
  <%= hidden_field_tag 'settings[overdue_block_subtasks]', '0', id: nil %>
  <%= check_box_tag 'settings[overdue_block_subtasks]', '1',
        RedmineFinalDate::Settings.truthy?(settings['overdue_block_subtasks']),
        id: 'settings_overdue_block_subtasks' %>
  <label for="settings_overdue_block_subtasks" style="float:none; margin-left:0; width:auto;"><%= l(:label_rfd_block_subtasks) %></label>
  <br><em class="info"><%= l(:hint_rfd_block_subtasks) %></em>
</p>

<%# ================================================================ %>
<%# Automated date update section                                    %>
<%# ================================================================ %>

<h3><%= l(:label_auto_date_update_settings) %></h3>

<%# --- filter_id -------------------------------------------------- %>
<p>
  <label for="settings_filter_id"><%= l(:label_filter_id) %>:</label><br/>
  <%
    query_options = IssueQuery.order(:name).map { |q| [q.name, q.id] }
  %>
  <%= select_tag 'settings[filter_id]',
        options_for_select(query_options, settings['filter_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_filter_id' %>
  <a id="rfd_edit_filter_link"
     href="#"
     target="_blank"
     style="display:none; margin-left:6px; vertical-align:middle;"
     title="Редактировать фильтр">&#9998;</a>
</p>

<%# --- date_mode -------------------------------------------------- %>
<p>
  <label for="settings_date_mode"><%= l(:label_date_mode) %>:</label><br/>
  <%
    date_mode_options = [
      [l(:label_date_mode_add_to_today), 'add_to_today'],
      [l(:label_date_mode_add_to_field), 'add_to_field'],
      [l(:label_date_mode_set_fixed),    'set_fixed']
    ]
  %>
  <%= select_tag 'settings[date_mode]',
        options_for_select(date_mode_options, settings['date_mode']),
        id: 'settings_date_mode' %>
</p>

<%# --- date_days (visible for add_to_today / add_to_field) -------- %>
<p id="rfd_date_days_row">
  <label for="settings_date_days"><%= l(:label_date_days) %>:</label>
  <%= text_field_tag 'settings[date_days]', settings['date_days'],
        id: 'settings_date_days', size: 6 %>
  <em class="info"><%= l(:hint_date_days) %></em>
</p>

<%# --- date_fixed (visible only for set_fixed) ------------------- %>
<p id="rfd_date_fixed_row" style="display:none;">
  <label for="settings_date_fixed"><%= l(:label_date_fixed) %>:</label>
  <%= text_field_tag 'settings[date_fixed]', settings['date_fixed'],
        id: 'settings_date_fixed', size: 12, placeholder: 'YYYY-MM-DD' %>
</p>

<%# --- comment_text ----------------------------------------------- %>
<p>
  <label for="settings_comment_text"><%= l(:label_comment_text) %>:</label><br/>
  <%= text_area_tag 'settings[comment_text]', settings['comment_text'],
        id: 'settings_comment_text', rows: 3, cols: 60 %>
  <em class="info"><%= l(:hint_comment_text) %></em>
</p>

<%# --- acting_user_id --------------------------------------------- %>
<p>
  <label for="settings_acting_user_id"><%= l(:label_acting_user_id) %>:</label><br/>
  <%
    user_options = User.active.sorted.map { |u| [u.name, u.id] }
  %>
  <%= select_tag 'settings[acting_user_id]',
        options_for_select(user_options, settings['acting_user_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_acting_user_id' %>
  <em class="info"><%= l(:hint_acting_user_id) %></em>
</p>

<%# --- responsible_field_id --------------------------------------- %>
<p>
  <label for="settings_responsible_field_id"><%= l(:label_responsible_field_id) %>:</label><br/>
  <%
    user_field_options = CustomField.where(type: 'IssueCustomField', field_format: 'user').order(:name).map { |f| [f.name, f.id] }
  %>
  <%= select_tag 'settings[responsible_field_id]',
        options_for_select(user_field_options, settings['responsible_field_id'].to_i),
        include_blank: true,
        class: 'rfd-select2',
        id: 'settings_responsible_field_id' %>
  <em class="info"><%= l(:hint_responsible_field_id) %></em>
</p>

<%# --- cron_schedule ---------------------------------------------- %>
<p>
  <label for="settings_cron_schedule"><%= l(:label_cron_schedule) %>:</label><br/>
  <%= text_field_tag 'settings[cron_schedule]', settings['cron_schedule'],
        id: 'settings_cron_schedule', size: 25, placeholder: '0 16 * * 1-5' %>
</p>

<p>
  <strong><%= l(:label_cron_command) %>:</strong><br/>
  <code style="display:block;background:#f4f4f4;padding:8px;margin-top:4px;font-size:12px;word-break:break-all;">
    <%= h(settings['cron_schedule'].presence || '0 16 * * 1-5') %>
    &nbsp;cd <%= h(Rails.root.to_s) %> &amp;&amp; RAILS_ENV=<%= h(Rails.env) %> bundle exec rake redmine:final_date:update_dates &gt;&gt; /var/log/redmine_final_date.log 2&gt;&amp;1
  </code>
</p>

<%# ================================================================ %>
<%# Select2 + toggle JS                                              %>
<%# ================================================================ %>

<%# Select2 lives in a separate plugin. Load it only when that plugin is actually
    installed, otherwise the asset URLs 404 and the whole script block below dies. %>
<% if Redmine::Plugin.installed?(:a_common_libs) %>
  <%= javascript_include_tag 'select2/select2.js', plugin: 'a_common_libs' %>
  <%= stylesheet_link_tag 'select2', plugin: 'a_common_libs' %>
<% end %>

<script type="text/javascript">
(function($) {
  $(document).ready(function() {
    // Initialise Select2 on all plugin dropdowns — plain selects if unavailable.
    if ($.fn.select2) {
      $('.rfd-select2').select2({ width: '300px' });
      $('.rfd-select2-wide').select2({ width: '520px' });
    }

    // Show/hide date_days vs date_fixed based on selected mode
    function rfdToggleDateFields() {
      var mode = $('#settings_date_mode').val();
      if (mode === 'set_fixed') {
        $('#rfd_date_days_row').hide();
        $('#rfd_date_fixed_row').show();
      } else {
        $('#rfd_date_fixed_row').hide();
        $('#rfd_date_days_row').show();
      }
    }

    rfdToggleDateFields();
    $('#settings_date_mode').on('change', rfdToggleDateFields);

    // Update edit-filter link when query selection changes.
    // Built from a server-rendered template so it honours relative_url_root.
    var rfdQueryEditUrl = <%= raw edit_query_path(:id => '__RFD_ID__').to_json %>;

    function rfdUpdateFilterLink() {
      var id  = $('#settings_filter_id').val();
      var $a  = $('#rfd_edit_filter_link');
      if (id) {
        $a.attr('href', rfdQueryEditUrl.replace('__RFD_ID__', id)).show();
      } else {
        $a.hide();
      }
    }

    rfdUpdateFilterLink();
    $('#settings_filter_id').on('change', rfdUpdateFilterLink);
  });
})(jQuery);
</script>
